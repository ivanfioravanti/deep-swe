# Grok Build CLI (recommended for Composer 2.5 via grok-composer-2.5-fast).
# Generate at https://console.x.ai/
XAI_API_KEY=

# Optional: paste the contents of ~/.grok/auth.json for grok.com session auth
# instead of XAI_API_KEY (useful when Composer routing requires a logged-in account).
# GROK_AUTH_JSON=

# Alternative: direct Cursor CLI runs (examples/composer-2.5-job.yaml).
# CURSOR_API_KEY=